# Tutorial 8: Simulate and drive. PRE=cs/t_v5scene.cs (tutorial 2's drivetrain).
do partsreset 2
do camera 0 0 0 30 30 40
frame 0 0.8
move 980,620 0.01
wait 1.0

# 1 Intro
line 1
frame 8 0.8 yaw:70 pitch:30
waitline

# 2 Simulate
line 2
click ui:Top Bar/Bar/Right/Simulate 0.9
wait 3.5
move ui:Minimize 0.8
wait 0.8
click
waitline

# 3 Drive
line 3
wait 1.2
hold W
wait 1.4
release W
wait 0.6
hold RightArrow
wait 0.9
release RightArrow
wait 0.4
hold S
wait 1.0
release S
waitline

# 4 Speed
line 4
hold LeftArrow
wait 0.7
release LeftArrow
hold W
wait 1.6
release W
wait 0.3
hold RightArrow
wait 1.2
release RightArrow
waitline

# 5 Stop
line 5
click ui:Top Bar/Bar/Right/Simulate 0.9
wait 0.6
frame 1.2 0.8 yaw:30 pitch:30
move 980,640 0.8
waitline
wait 0.8
