# Unity generated folders (rebuilt automatically, never commit)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store tools
/[Aa]ssets/AssetStoreTools*

# IDE / solution files (regenerated by Unity)
.vs/
.vscode/
.idea/
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity metadata that shouldn't be shared
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
crashlytics-buildid.txt
*.apk
*.aab
*.unitypackage
*.app

# Blender backups
*.blend1
*.blend2

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Claude Code local settings
.claude/settings.local.json

# Screenshots taken while testing (Unity MCP camera captures)
/[Aa]ssets/[Ss]creenshots/
/[Aa]ssets/[Ss]creenshots.meta

# Python bytecode from the Blender/texture scripts
__pycache__/
*.pyc

# Builds saved while running in the editor (the original Protobot saves to Application.dataPath/Builds)
/[Aa]ssets/Builds/
/[Aa]ssets/Builds.meta

# The bug report webhook (Builds/BugReport.Webhook): built into the app, kept out of the repository
/Assets/ProtobotRebuilt/Resources/Secrets/
/Assets/ProtobotRebuilt/Resources/Secrets.meta
